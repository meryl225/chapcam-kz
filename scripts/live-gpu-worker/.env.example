# ============================================================
# ChapCam Live - worker GPU (mode cloud, server.py)
# ============================================================

# OBLIGATOIRE : doit etre STRICTEMENT identique a LIVE_GPU_SHARED_SECRET
# defini dans l'app Next.js (sinon tous les tokens seront rejetes).
LIVE_GPU_SHARED_SECRET=change-moi-pour-le-meme-secret-que-next

# Reseau
CHAPCAM_HOST=0.0.0.0
CHAPCAM_PORT=8765

# Capacite GPU : nombre de sessions de swap simultanees avant mise en file d'attente.
# Adapter a la VRAM (ex: 1 a 2 pour une T4/3060, 3-4 pour une 4090/A10).
CHAPCAM_MAX_CONCURRENT=2

# Qualite/latence
CHAPCAM_JPEG_QUALITY=70      # qualite JPEG renvoyee (50-85)
CHAPCAM_DET_SIZE=320         # taille de detection (256 = + rapide, 640 = + precis)
CHAPCAM_REDETECT_EVERY=8     # redetecter le visage toutes les N frames (tracking)

# Acceleration
CHAPCAM_USE_TRT=1            # 1 = activer TensorRT si dispo (compile au 1er run)
CHAPCAM_TRT_CACHE=/tmp/chapcam-trt-cache
CHAPCAM_MODEL_ROOT=/models
