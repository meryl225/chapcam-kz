# ---- Server ----
PORT=8787
# Comma-separated list of allowed origins for CORS. Use * to allow all (dev only).
ALLOWED_ORIGINS=*

# ---- RunPod / ComfyUI ----
# Base URL of your RunPod endpoint. Two modes are supported:
#  1) Serverless endpoint:  https://api.runpod.ai/v2/<ENDPOINT_ID>
#  2) Direct ComfyUI pod:    https://<POD_ID>-8188.proxy.runpod.net
RUNPOD_BASE_URL=https://api.runpod.ai/v2/REPLACE_ENDPOINT_ID

# Set to "serverless" (uses /runsync) or "comfyui" (uses /prompt + history polling)
RUNPOD_MODE=serverless

# RunPod API key (required for serverless mode; optional for a public pod proxy)
RUNPOD_API_KEY=REPLACE_WITH_YOUR_KEY

# Per-frame request timeout in milliseconds
RUNPOD_TIMEOUT_MS=15000

# How many frames may be enhanced concurrently (protects the GPU + memory)
MAX_CONCURRENCY=2

# JPEG quality for the output MJPEG stream (1-31, lower = better quality, ffmpeg scale)
OUTPUT_JPEG_QUALITY=4

# If true and RunPod fails, the original frame is passed through instead of erroring
FALLBACK_TO_ORIGINAL=true
